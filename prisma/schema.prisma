generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN")
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  category      String
  client        String?
  year          String?
  summary       String
  description   String
  coverImage    String
  galleryImages String?
  liveUrl       String?
  githubUrl     String?
  figmaUrl      String?
  behanceUrl    String?
  dribbbleUrl   String?
  featured      Boolean  @default(false)
  order         Int      @default(0)
  tags          String?
  challenges    String?
  solutions     String?
  results       String?
  goal          String?
  solution      String?
  tools         String?
  seoTitle      String?
  seoDescription String?
  altText       String?
  serviceId     String?
  service       Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceSlug   String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Service {
  id           String    @id @default(uuid())
  title        String
  slug         String    @unique
  tagline      String?
  description  String
  icon         String?
  features     String?
  deliverables String?
  order        Int       @default(0)
  active       Boolean   @default(true)
  packages     Package[]
  projects     Project[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Package {
  id               String   @id @default(uuid())
  serviceId        String?
  service          Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  name             String
  description      String?
  price            Decimal
  billingPeriod    String   @default("per-project")
  features         String
  excludedFeatures String?
  isPopular        Boolean  @default(false)
  order            Int      @default(0)
  active           Boolean  @default(true)
  ctaText          String   @default("Book Package")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Testimonial {
  id            String   @id @default(uuid())
  clientName    String
  clientRole    String?
  clientCompany String
  clientAvatar  String?
  brandLogo     String?
  serviceId     String?
  content       String
  rating        Int      @default(5)
  projectTitle  String?
  status        String   @default("APPROVED") // APPROVED | PENDING | DRAFT | REJECTED
  featured      Boolean  @default(false)
  active        Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String   @default("General")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClientBrand {
  id         String   @id @default(uuid())
  name       String
  logoUrl    String
  websiteUrl String?
  order      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ContactInquiry {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String?
  company     String?
  service     String?
  budget      String?
  projectType String?
  deadline    String?
  subject     String?
  message     String
  status      String   @default("NEW") // NEW | CONTACTED | IN_DISCUSSION | CONVERTED | CLOSED | SPAM
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Booking {
  id             String   @id @default(uuid())
  name           String
  email          String
  phone          String?
  company        String?
  serviceName    String?
  budget         String?
  projectDetails String?
  date           String
  timeSlot       String
  meetingLink    String?
  notes          String?
  status         String   @default("PENDING") // PENDING | CONFIRMED | RESCHEDULED | COMPLETED | CANCELLED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Media {
  id        String   @id @default(uuid())
  fileName  String
  fileUrl   String
  fileType  String
  fileSize  Int
  altText   String?
  source    String   @default("LOCAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invoice {
  id              String   @id @default(uuid())
  invoiceNumber   String   @unique
  clientName      String
  clientEmail     String
  clientCompany   String?
  clientAddress   String?
  clientPhone     String?
  issueDate       String
  dueDate         String
  status          String   @default("UNPAID")
  currency        String   @default("$")
  currencyCode    String   @default("USD")
  items           String
  subtotal        Decimal  @default(0)
  discountPercent Decimal  @default(0)
  taxPercent      Decimal  @default(0)
  totalAmount     Decimal  @default(0)
  notes           String?
  paymentTerms    String?
  paymentMethods  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
