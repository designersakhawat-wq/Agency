# ==========================================
# PRODUCTION ENVIRONMENT CONFIG FOR HOSTINGER
# Md Sakhawat Hossain - Designer Portfolio & Admin CMS
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=production
APP_URL=https://yourdomain.com
CLIENT_URL=https://yourdomain.com

# Database Connection
# Option A (Recommended for 0-config Hostinger Node.js App): SQLite (Persistent File)
DATABASE_URL="file:./prisma/dev.db"

# Option B (Hostinger MySQL Database if preferred):
# DATABASE_URL="mysql://u123456789_user:YourDbPassword@localhost:3306/u123456789_portfolio"

# JWT Authentication (Generate a long random secure string in production)
JWT_SECRET=sakhawat_super_secret_production_jwt_key_89234892374892374
JWT_EXPIRES_IN=7d

# Default Admin Account
ADMIN_NAME="Md Sakhawat Hossain"
ADMIN_EMAIL=admin@sakhawat.design
ADMIN_PASSWORD=admin123456

# Primary Notification Target for Inquiries & Bookings
ADMIN_NOTIFICATION_EMAIL=designersakhawat@gmail.com

# SMTP Email Settings (Hostinger Webmail or Gmail App Password)
# Hostinger Webmail Example:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=contact@yourdomain.com
# SMTP_PASS=your_email_password
# SMTP_FROM_NAME="Md Sakhawat Hossain"
# SMTP_FROM_EMAIL=contact@yourdomain.com

# Gmail Example:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=designersakhawat@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM_NAME="Md Sakhawat Hossain"
SMTP_FROM_EMAIL=designersakhawat@gmail.com

# Cloudinary Media Storage (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sakhawat_portfolio

# Security Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
