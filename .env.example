# ==========================================
# PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIG
# Md Sakhawat Hossain - Designer Portfolio & Admin CMS
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Database Connection (MySQL)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
# Example for Local: mysql://root:password@127.0.0.1:3306/sakhawat_portfolio
# Example for Hostinger: mysql://u123456789_portfolio:YourSecurePassword@127.0.0.1:3306/u123456789_portfolio
DATABASE_URL="mysql://root:@127.0.0.1:3306/sakhawat_portfolio"

# JWT Authentication
JWT_SECRET=sakhawat_super_secret_jwt_key_98374982374982374
JWT_EXPIRES_IN=7d

# Default Admin Credentials for Seeding
ADMIN_NAME="Md Sakhawat Hossain"
ADMIN_EMAIL=admin@sakhawat.design
ADMIN_PASSWORD=admin123456

# Primary Notification Email Target
ADMIN_NOTIFICATION_EMAIL=designersakhawat@gmail.com

# Email Configuration (Nodemailer / SMTP)
# Leave empty if SMTP is not yet configured (app will safely record inquiries in MySQL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=designersakhawat@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM_NAME="Sakhawat Portfolio"
SMTP_FROM_EMAIL=designersakhawat@gmail.com

# Alternative: Resend API Key (Optional)
RESEND_API_KEY=

# Cloudinary Media Storage (Optional - Dual Engine)
# If left empty, uploads fallback automatically to local /uploads directory
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sakhawat_portfolio

# Security & CORS
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
